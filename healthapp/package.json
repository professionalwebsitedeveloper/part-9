{
  "name": "healthapp",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "tsc": "tsc",
    "calculateBmi": "tsc && node bmiCalculator.ts",
    "calculateExercises": "tsc && node exerciseCalculator.ts",
